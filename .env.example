# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Pi Network Ecosystem Credentials
PI_SERVER_API_KEY=
PI_NETWORK_API_KEY=
PI_API_KEY=
PI_SERVER_KEY=
PI_API_SECRET=
PI_DEVELOPER_KEY=
PI_KEY=
PI_SECRET_KEY=
PI_API_SERVER_KEY=
PI_NETWORK_SERVER_KEY=
PI_NETWORK_APP_ID=

# Platform & Security Secrets
ADMIN_SECRET_KEY="piflix_admin_secure_key_2025"
JWT_SECRET="piflix_jwt_super_secret"

# Streaming & Ad Configuration
AD_PROVIDER_ID=""
STORAGE_URL=""
DATABASE_URL=""

# Support Email Mailbox Integration (support@piflixplus.network)
SUPPORT_EMAIL="support@piflixplus.network"
SUPPORT_EMAIL_PASSWORD=""
IMAP_HOST="imap.piflixplus.network"
IMAP_PORT="993"
IMAP_SECURE="true"
SMTP_HOST="smtp.piflixplus.network"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="support@piflixplus.network"
SMTP_PASSWORD=""

