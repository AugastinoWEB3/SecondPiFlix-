{
  "entities": {
    "content": {
      "title": "ContentItem",
      "description": "Movie or TV Series streaming metadata record",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 5000 },
        "type": { "type": "string", "enum": ["movie", "series"] },
        "coverImageUrl": { "type": "string", "maxLength": 1000 },
        "videoUrl": { "type": "string", "maxLength": 1000 },
        "trailerUrl": { "type": "string", "maxLength": 1000 },
        "year": { "type": "number" },
        "genre": { "type": "string", "maxLength": 200 },
        "language": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "quality": { "type": "string", "enum": ["HD", "FHD", "4K"] },
        "accessType": { "type": "string", "enum": ["free", "premium"] },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": [
        "title",
        "type",
        "coverImageUrl",
        "videoUrl",
        "year",
        "genre",
        "language",
        "rating",
        "quality",
        "accessType",
        "published",
        "createdAt",
        "updatedAt"
      ]
    },
    "admin": {
      "title": "Admin",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["email", "role"]
    },
    "settings": {
      "title": "AppSettings",
      "description": "Global application configuration and pricing settings",
      "type": "object",
      "properties": {
        "appName": { "type": "string", "maxLength": 100 },
        "appTagline": { "type": "string", "maxLength": 200 },
        "monthlyPricePi": { "type": "number" },
        "annualPricePi": { "type": "number" },
        "freeTrialDays": { "type": "number" },
        "adFrequencyMinutes": { "type": "number" },
        "piWalletAddress": { "type": "string", "maxLength": 200 },
        "maintenanceMode": { "type": "boolean" },
        "announcementBanner": { "type": "string", "maxLength": 500 }
      },
      "required": ["appName", "monthlyPricePi", "annualPricePi"]
    },
    "notifications": {
      "title": "Notification",
      "description": "System release alerts and user notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["new_movie", "new_series", "new_episode", "premium", "announcement"] },
        "contentId": { "type": "string", "maxLength": 100 },
        "contentType": { "type": "string", "enum": ["movie", "series"] },
        "coverImageUrl": { "type": "string", "maxLength": 2000 },
        "targetTab": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "read": { "type": "boolean" },
        "readBy": { "type": "array" }
      },
      "required": ["userId", "title", "message", "type", "createdAt", "read"]
    },
    "visitors": {
      "title": "VisitorRecord",
      "description": "Anonymous unique visitor tracking and session record for analytics",
      "type": "object",
      "properties": {
        "visitorId": { "type": "string", "maxLength": 128 },
        "source": { "type": "string", "enum": ["pi_browser", "external_web"] },
        "piUserId": { "type": "string", "maxLength": 128 },
        "piUsername": { "type": "string", "maxLength": 128 },
        "firstSeen": { "type": "string", "maxLength": 100 },
        "lastSeen": { "type": "string", "maxLength": 100 },
        "visitDates": { "type": "array" },
        "visitCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["visitorId", "source", "firstSeen", "lastSeen", "visitCount"]
    }
  },
  "firestore": {
    "/content/{contentId}": {
      "schema": "content",
      "description": "Public and admin media metadata repository"
    },
    "/admins/{adminId}": {
      "schema": "admin",
      "description": "Admin RBAC authorization records"
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "Global application configuration documents"
    },
    "/notifications/{notificationId}": {
      "schema": "notifications",
      "description": "Public release announcements and user notifications"
    },
    "/visitors/{visitorId}": {
      "schema": "visitors",
      "description": "Persistent visitor tracking records for unique visitor analytics"
    }
  }
}
